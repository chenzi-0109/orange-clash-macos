{
  "name": "orange-clash-macos",
  "version": "1.0.0",
  "description": "Orange Clash - macOS Edition (Liquid Glass Proxy Client with Built-in Mihomo Core)",
  "main": "dist-electron/main.js",
  "author": "Orange Clash",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "pack:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "pack:mac:x64": "npm run build && electron-builder --mac --x64",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --x64"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.orangeclash.macos",
    "productName": "Orange Clash",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources",
        "to": "assets",
        "filter": [
          "*.png",
          "*.icns"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Orange Clash ${arch}",
      "artifactName": "Orange-Clash-${version}-macOS-${arch}.dmg",
      "contents": [
        {
          "x": 140,
          "y": 170
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
